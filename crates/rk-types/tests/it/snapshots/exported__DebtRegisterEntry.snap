---
source: crates/rk-types/tests/it/schema_snapshot.rs
expression: schema
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DebtRegisterEntry",
  "description": "A technical-debt register entry.",
  "type": "object",
  "properties": {
    "items": {
      "description": "The debts the change took on, one entry each; empty when it took on none.",
      "type": "array",
      "items": {
        "description": "One debt the change took on: a shortcut, a deferred fix or a known gap, and where it sits.\nEach becomes its own tracked tech-debt item.",
        "type": "object",
        "properties": {
          "title": {
            "description": "The shortcut or debt, in one line.",
            "type": "string"
          },
          "location": {
            "description": "Where it sits: the files, module or rule the shortcut is in.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "location"
        ]
      }
    },
    "interest": {
      "description": "A free-text field. AC-283 names `claim` and `rationale` as the only free-text fields on a\nfinding, and neither is an input to the classifier or to `policy::classify`.",
      "type": "string"
    },
    "remediation": {
      "description": "A free-text field. AC-283 names `claim` and `rationale` as the only free-text fields on a\nfinding, and neither is an input to the classifier or to `policy::classify`.",
      "type": "string"
    },
    "summary": {
      "description": "A free-text field. AC-283 names `claim` and `rationale` as the only free-text fields on a\nfinding, and neither is an input to the classifier or to `policy::classify`.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "items",
    "interest",
    "remediation",
    "summary"
  ]
}
