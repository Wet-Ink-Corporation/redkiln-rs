---
source: crates/rk-types/tests/it/schema_snapshot.rs
expression: schema
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs",
  "description": "The docs a change lands, in their quadrant.",
  "type": "object",
  "properties": {
    "quadrant": {
      "description": "The Diataxis quadrant a page belongs to (the `docs-diataxis` checklist: tutorial, how-to,\nreference or explanation).",
      "type": "string",
      "enum": [
        "tutorial",
        "how-to",
        "reference",
        "explanation"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "description": "A free-text field. AC-283 names `claim` and `rationale` as the only free-text fields on a\nfinding, and neither is an input to the classifier or to `policy::classify`.",
      "type": "string"
    },
    "stale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "description": "Why the pages sit in that quadrant.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "quadrant",
    "files",
    "summary",
    "stale",
    "rationale"
  ]
}
